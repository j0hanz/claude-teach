{
  "description": "claude-teach session hooks. Bash-only (shell form): the interpreter is picked with `command -v`, which PowerShell cannot parse. Requires python or python3 on PATH; silent no-op outside a teach workspace.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/teach_hook.py\" --event session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/teach_hook.py\" --event session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/teach_hook.py\" --event stop"
          },
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/teach_hook.py\" --event stop-sweep"
          }
        ]
      }
    ]
  }
}
